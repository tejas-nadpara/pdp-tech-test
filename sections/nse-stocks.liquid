<script src="https://cdnjs.cloudflare.com/ajax/libs/jquery/3.7.1/jquery.min.js" ></script>
<script src="https://cdn.datatables.net/2.2.0/js/dataTables.js" ></script>
<link href="https://cdn.datatables.net/2.2.0/css/dataTables.dataTables.css" rel="stylesheet" type="text/css" media="all" />


<section class="">
  <div class="page-width section-{{ section.id }}-padding{% if section.settings.secondary_background %} isolate{% endif %}">

    <table id="example" class="nse-sttocks" style="width:100%">
        <thead>
            <tr>
                <th>Symbol</th>
                <th>previousClose</th>
                <th>lastPrice</th>
                <th>change</th>
                <th>pChange</th>
                <th>totalTradedVolume</th>
            </tr>
        </thead>
        <tbody>
            
        </tbody>
    </table>
    
  </div>
</section>

<script>
  $(document).ready(function(){
    loadNSEStock()
    var nseTable = new DataTable('.nse-sttocks');
  });


  var tableData = `<table id="example" class="nse-sttocks" style="width:100%">
                      <thead>
                          <tr>
                              <th>Symbol</th>
                              <th>previousClose</th>
                              <th>lastPrice</th>
                              <th>change</th>
                              <th>pChange</th>
                              <th>PCR</th>
                              <th>Vol Diff</th>
                              <th>totalTradedVolume</th>
                          </tr>
                      </thead>
                      <tbody>            
                      </tbody>
                  </table>`;

  async function loadScript() {
      var script1 = document.createElement('script');
      script1.type = 'text/javascript';
      script1.src = 'https://cdnjs.cloudflare.com/ajax/libs/jquery/3.7.1/jquery.min.js';
      document.body.appendChild(script1);
      console.log('loadScript');
/*
      var script2 = document.createElement('script');
      script2.type = 'text/javascript';
      script2.src = 'https://cdn.datatables.net/2.2.0/js/dataTables.js';
      document.body.appendChild(script2);
      console.log('loadScript');

      var script3 = document.createElement('link');
      script3.type = 'text/css';
      script3.src = 'https://cdn.datatables.net/2.2.0/css/dataTables.dataTables.css';
      document.body.appendChild(script3);
      console.log('loadScript');
    */
  }
  async function loadNSEStock(){
    $.ajax({
        method: "GET",
        dataType: "JSON",
        url: "https://www.nseindia.com/api/equity-stockIndices?index=SECURITIES%20IN%20F%26O",
        success: async function (response) {
            console.log(response);
            if(response == undefined){
              $(".main").html("<h3>Data not loaded</h3>");
            }else{
              $(".main").html(tableData);
              await viewStockData(response);
            }
        }
    })
  }

  async function viewStockData(response){
    $(response.data).each(async function(i, stock){
      $(".nse-sttocks tbody").append(`<tr>
                                        <td>${stock.symbol}</td>
                                        <td>${stock.previousClose}</td>
                                        <td>${stock.lastPrice}</td>
                                        <td>${stock.change}</td>
                                        <td>${stock.pChange}</td>
                                        <td class="pcr-data">0</td>
                                        <td class="vol-diff">0</td>
                                        <td>${stock.totalTradedVolume}</td>
                                      </tr>`);
    });
    await addPCRData();
    setTimeout(function(){
      var nseTable = new DataTable('.nse-sttocks');
    },10000);
    
    
  }

  async function addPCRData(){
    if($(".nse-sttocks tr:not(.loaded)").length){
      $(".nse-sttocks tr:not(.loaded)").each(async function(){
        var stockObj = $(this);
        var stockSymbol = stockObj.find("td:eq(0)").text();
        setTimeout(async function(){
          $.ajax({
              method: "GET",
              dataType: "JSON",
              url: "https://www.nseindia.com/api/option-chain-equities?symbol="+stockSymbol,
              success: async function (response) {
                  console.log(response);
                  if(response != undefined){
                    var callOI = response.filtered['CE'].totOI;
                    var putOI = response.filtered['PE'].totOI;
                    var pcr = (putOI / callOI).toFixed(1);
                    stockObj.find(".pcr-data").text(pcr);
  
                    var callVol = response.filtered['CE'].totVol;
                    var putVol = response.filtered['PE'].totVol;
                    var volDiff = (putVol / callVol).toFixed(1);
                    stockObj.find(".vol-diff").text(volDiff);
                    stockObj.addClass("loaded");
                    addPCRData();
                  }
              }
          });
        }, 250);
      });
    }
  }
  
  loadScript();
  loadNSEStock();
</script>

{% schema %}
  {
    "name": "NSE Stocks",
    "settings": [],
    "presets": [
      {
        "name": "NSE Stocks"
      }
    ]
  }
{% endschema %}