<script src="https://cdnjs.cloudflare.com/ajax/libs/jquery/3.7.1/jquery.min.js" ></script>
<script src="https://cdn.datatables.net/2.2.0/js/dataTables.js" ></script>
<link href="https://cdn.datatables.net/2.2.0/css/dataTables.dataTables.css" rel="stylesheet" type="text/css" media="all" />


<section class="">
  <div class="page-width section-{{ section.id }}-padding{% if section.settings.secondary_background %} isolate{% endif %}">

    <table id="example" class="nse-sttocks" style="width:100%">
        <thead>
            <tr>
                <th>Symbol</th>
                <th>previousClose</th>
                <th>lastPrice</th>
                <th>change</th>
                <th>pChange</th>
                <th>totalTradedVolume</th>
            </tr>
        </thead>
        <tbody>
            
        </tbody>
    </table>
    
  </div>
</section>

<script>
  $(document).ready(function(){
    loadNSEStock()
    var nseTable = new DataTable('.nse-sttocks');
  });


  var tableData = `<table id="example" class="nse-sttocks" style="width:100%">
                      <thead>
                          <tr>
                              <th>Symbol</th>
                              <th>lastPrice</th>
                              <th>change</th>
                              <th>pChange</th>
                              <th>Call OI change</th>
                              <th>Put OI change</th>
                              <th>PCR</th>                            
                              <th>Vol Diff</th>
                              <th>totalTradedVolume</th>
                          </tr>
                      </thead>
                      <tbody>            
                      </tbody>
                  </table>`;

  tableData += "<div>Total Call OIC: <span class='totalCallOIChange'></span></div><br>";
  tableData += "<div>Total Put OIC: <span class='totalPutOIChange'></span></div><br>";
  tableData += "<div>Total PCR: <span class='totalPCR'></span></div>";

  async function loadScript() {
      var script1 = document.createElement('script');
      script1.type = 'text/javascript';
      script1.src = 'https://cdnjs.cloudflare.com/ajax/libs/jquery/3.7.1/jquery.min.js';
      document.body.appendChild(script1);
      console.log('loadScript');
/*
      var script2 = document.createElement('script');
      script2.type = 'text/javascript';
      script2.src = 'https://cdn.datatables.net/2.2.0/js/dataTables.js';
      document.body.appendChild(script2);
      console.log('loadScript');

      var script3 = document.createElement('link');
      script3.type = 'text/css';
      script3.src = 'https://cdn.datatables.net/2.2.0/css/dataTables.dataTables.css';
      document.body.appendChild(script3);
      console.log('loadScript');
    */
  }
  async function loadNSEStock(){
    $.ajax({
        method: "GET",
        dataType: "JSON",
        url: "https://www.nseindia.com/api/equity-stockIndices?index=SECURITIES%20IN%20F%26O",
        success: async function (response) {
            console.log(response);
            if(response == undefined){
              $(".main").html("<h3>Data not loaded</h3>");
            }else{
              $(".main").html(tableData);
              await viewStockData(response);
            }
        }
    })
  }

  async function viewStockData(response){
    $(response.data).each(async function(i, stock){
      $(".nse-sttocks tbody").append(`<tr>
                                        <td>${stock.symbol}</td> 
                                        <td>${stock.lastPrice}</td>
                                        <td>${stock.change}</td>
                                        <td>${stock.pChange}</td>
                                        <td class="call-oi-change">0</td>
                                        <td class="put-oi-change">0</td>
                                        <td class="pcr-data">0</td>
                                        <td class="callBuyQty">0</td>
                                        <td class="callSellQty">0</td>
                                        <td class="putBuyQty">0</td>
                                        <td class="putSellQty">0</td>
                                        <td class="vol-diff">0</td>
                                        <td>${stock.totalTradedVolume}</td>
                                      </tr>`);
    });
    await addPCRData();
   
  }

  var stockCnt = 0;
  var totalCallOIChange = 0, totalPutOIChange = 0;
  async function addPCRData(){
    if($(".nse-sttocks tr:not(.loaded)").length > 1){        
        var stockObj = $(".nse-sttocks tr:not(.loaded)").last();
        var stockSymbol = stockObj.find("td:eq(0)").text().replace("&", "%26")
          $.ajax({
              method: "GET",
              dataType: "JSON",
              url: "https://www.nseindia.com/api/option-chain-equities?symbol="+stockSymbol,
              success: async function (data) {
                  var response = await data;
                  console.log(response);
                  if(response.filtered != undefined ){
                    var callOIC = 0, putOIC = 0;
                    var callOI = 0, putOI = 0;
                    var callVol = 0, putVol = 0;
                    var callBuyQty = 0, callSellQty = 0;
                    var putBuyQty = 0, putSellQty = 0;
                    var underlyingValue = 0;
                    var oiArray = [];
                    $(response.filtered.data).each(function(i, oc){
                      oiArray.push(oc);
                      if(oc['CE'] != undefined){
                        if(oc['CE'].underlyingValue != undefined){
                          underlyingValue = parseFloat(oc['CE'].underlyingValue);
                        }
                      }
                    });
                    
                    $(oiArray).each(function(i, oi_item){
                      var strikePrice = parseFloat(oi_item.strikePrice);
                      if(strikePrice > underlyingValue){
                        if(oi_item['CE'] != undefined){
                          callOIC += parseFloat(oi_item['CE'].changeinOpenInterest);
                          callOI += parseFloat(oi_item['CE'].openInterest);

                          callBuyQty += parseInt(oi_item['CE'].totalBuyQuantity);
                          callSellQty += parseInt(oi_item['CE'].totalSellQuantity);
                        }

                        if(oiArray[i+1]['CE'] != undefined){
                          callOIC += parseFloat(oiArray[i+1]['CE'].changeinOpenInterest);
                          callOI += parseFloat(oiArray[i+1]['CE'].openInterest);

                          callBuyQty += parseInt(oiArray[i+1]['CE'].totalBuyQuantity);
                          callSellQty += parseInt(oiArray[i+1]['CE'].totalSellQuantity);
                        }
                          
                        if(oiArray[i+2]['CE'] != undefined){
                          callOIC += parseFloat(oiArray[i+2]['CE'].changeinOpenInterest);
                          callOI += parseFloat(oiArray[i+2]['CE'].openInterest);   

                          callBuyQty += parseInt(oiArray[i+2]['CE'].totalBuyQuantity);
                          callSellQty += parseInt(oiArray[i+2]['CE'].totalSellQuantity);
                        }
                        totalCallOIChange += callOIC;

                        if(oi_item['PE'] != undefined){
                          putOIC += parseFloat(oi_item['PE'].changeinOpenInterest);
                          putOI += parseFloat(oi_item['PE'].openInterest);

                          putBuyQty += parseInt(oi_item['PE'].totalBuyQuantity);
                          putSellQty += parseInt(oi_item['PE'].totalSellQuantity);
                        }

                        if(oiArray[i-1]['PE'] != undefined){
                          putOIC += parseFloat(oiArray[i-1]['PE'].changeinOpenInterest);
                          putOI += parseFloat(oiArray[i-1]['PE'].openInterest);

                          putBuyQty += parseInt(oiArray[i-1]['PE'].totalBuyQuantity);
                          putSellQty += parseInt(oiArray[i-1]['PE'].totalSellQuantity);
                        }

                        if(oiArray[i-2]['PE'] != undefined){
                          putOIC += parseFloat(oiArray[i-2]['PE'].changeinOpenInterest);
                          putOI += parseFloat(oiArray[i-2]['PE'].openInterest);

                          putBuyQty += parseInt(oiArray[i-2]['PE'].totalBuyQuantity);
                          putSellQty += parseInt(oiArray[i-2]['PE'].totalSellQuantity);
                        }
                        totalPutOIChange += putOIC;

                        stockObj.find(".call-oi-change").text(callOIC);
                        stockObj.find(".put-oi-change").text(putOIC);
                        stockObj.find(".pcr-data").text((putOIC / callOIC).toFixed(1));  

                        stockObj.find(".callBuyQty").text(callBuyQty);  
                        stockObj.find(".callSellQty").text(callSellQty);
                        stockObj.find(".putBuyQty").text(putBuyQty);  
                        stockObj.find(".putSellQty").text(putSellQty);
                        
                        stockObj.find(".vol-diff").text(putVol - callVol);
                        return false;
                      }
                      
                    });

                    // Total OI PCR
                    /*
                    var callOI = response.filtered['CE'].totOI;
                    var putOI = response.filtered['PE'].totOI;
                    var pcr = (putOI / callOI).toFixed(1);
                    stockObj.find(".pcr-data").text(pcr);
  
                    var callVol = response.filtered['CE'].totVol;
                    var putVol = response.filtered['PE'].totVol;
                    var volDiff = (putVol / callVol).toFixed(1);
                    stockObj.find(".vol-diff").text(volDiff);
                    */
                  
                  }
                 stockCnt++;
                 stockObj.addClass("loaded");
                 addPCRData();
              }
          });
      }else{
        var nseTable = new DataTable('.nse-sttocks');
        $(".totalCallOIChange").text(totalCallOIChange);
        $(".totalPutOIChange").text(totalPutOIChange);
        $(".totalPCR").text((totalPutOIChange/totalCallOIChange).toFixed(1)); 
      }
  }
  
  loadScript();
  loadNSEStock();
  // NSE STOCKS
</script>

{% schema %}
  {
    "name": "NSE Stocks",
    "settings": [],
    "presets": [
      {
        "name": "NSE Stocks"
      }
    ]
  }
{% endschema %}